# Server only. Never prefix these with VITE_. Never commit the filled file.
# Preferred: the private JWK generated by Supabase CLI and imported into your project.
# Include kid and alg="ES256"; keep the entire JSON value on one line.
CAMPUS_JWT_JWK=
# Optional legacy alternative: your project's trusted legacy JWT secret.
# Set ONE signing method. A newly generated unrelated secret will NOT work with Supabase.
CAMPUS_JWT_SECRET=
# Optional modern server secret API key (sb_secret_...). If empty, use the
# SUPABASE_SERVICE_ROLE_KEY automatically supplied to hosted Edge Functions.
CAMPUS_SERVER_KEY=
ALLOWED_ORIGINS=http://localhost:5173,https://your-campusstack.vercel.app
