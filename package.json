{
  "name": "campusstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:server": "node tests/local-server.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:bots": "node scripts/dev-local.mjs --bots"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "jose": "^6.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.28.2",
    "pg": "^8.16.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
